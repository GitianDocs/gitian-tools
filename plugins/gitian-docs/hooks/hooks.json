{
  "description": "gitian-docs: a SessionStart cue plus a PostToolUse nudge, both scoped to gitian-instrumented repos, that keep @gitian annotations and paired docs/ files in sync as code changes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/docs-context.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gitian-docs-nudge.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
